#!/bin/sh
for manuscript_python in python3 "$HOME/.local/bin/python3" python3.14 python3.13 python3.12 python3.11; do
    if "$manuscript_python" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
        exec "$manuscript_python" "$(dirname "$0")/manuscript.py" "$@"
    fi
done
echo 'Error: ManuscriptAgent requires Python 3.11 or newer.' >&2
exit 1
